<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SettingLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/brill_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SettingInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/edit_background</item>
        <item name="android:textColor">@color/brill_ink</item>
        <item name="android:textColorHint">#8870687A</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>
