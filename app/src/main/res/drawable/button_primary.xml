<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFE875B5" />
            <corners android:radius="22dp" />
            <padding android:left="18dp" android:top="12dp" android:right="18dp" android:bottom="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/brill_pink" android:endColor="@color/brill_blue" android:angle="0" />
            <corners android:radius="22dp" />
            <padding android:left="18dp" android:top="12dp" android:right="18dp" android:bottom="12dp" />
        </shape>
    </item>
</selector>
