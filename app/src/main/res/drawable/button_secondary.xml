<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#553F3A4E" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#AAFFFFFF" />
            <padding android:left="14dp" android:top="10dp" android:right="14dp" android:bottom="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#333F3A4E" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <padding android:left="14dp" android:top="10dp" android:right="14dp" android:bottom="10dp" />
        </shape>
    </item>
</selector>
